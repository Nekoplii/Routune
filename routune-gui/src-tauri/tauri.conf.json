{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "routune",
  "version": "0.0.0-dev",
  "identifier": "com.routune.gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && cargo build --release -p routune-daemon",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Routune",
        "width": 1100,
        "height": 720,
        "minWidth": 860,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "libasound2",
          "pipewire"
        ],
        "files": {
          "/usr/bin/routune-daemon": "../../target/release/routune-daemon",
          "/usr/lib/systemd/user/routune.service": "../../packaging/routune.service"
        }
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libayatana-appindicator3",
          "alsa-lib",
          "pipewire"
        ],
        "files": {
          "/usr/bin/routune-daemon": "../../target/release/routune-daemon",
          "/usr/lib/systemd/user/routune.service": "../../packaging/routune.service"
        }
      },
      "appimage": {
        "bundleMediaFramework": false,
        "files": {
          "/usr/bin/routune-daemon": "../../target/release/routune-daemon"
        }
      }
    }
  }
}
